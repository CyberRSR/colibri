+/* ---- IOLOG (scratch instrumentation): every read's submit/start/end and the MoE steps'
+ * phases, into MIMO_IOLOG at each request's report. Nothing computed changes. */
+typedef struct { double t; int32_t k, a, b, c, d, e; } IoEv;
+static IoEv *g_ev; static _Atomic long g_nev; static long g_evcap; static const char *g_evpath;
+static _Atomic int g_rid, g_reader_id;
+static int g_cur_li = -1;
+enum { EV_SUBMIT = 1, EV_START, EV_END, EV_PROMOTE, EV_DEMAND, EV_DEMAND_END, EV_MOE_BEGIN, EV_WAIT_BEGIN,
+       EV_WAIT_END, EV_MOE_END, EV_PRED, EV_FWD, EV_REQ, EV_USED, EV_WASTE, EV_EVICT, EV_WAVE_BEGIN, EV_WAVE_END,
+       EV_ATTN_BEGIN, EV_ATTN_END, EV_HIT, EV_FWD_END, EV_PRED_RANK };
+static double now_s(void);
+static void ev(int k, int a, int b, int c, int d, int e) {
+    if (!g_ev) return;
+    long i = atomic_fetch_add(&g_nev, 1);
+    if (i >= g_evcap) return;
+    g_ev[i] = (IoEv){now_s(), k, a, b, c, d, e};
+}
+static void ev_init(void) {
+    const char *p = getenv("MIMO_IOLOG");
+    if (!p || !*p) return;
+    g_evpath = p; g_evcap = 8L << 20;
+    g_ev = calloc((size_t)g_evcap, sizeof(IoEv));
+}
+static void ev_flush(void) {
+    if (!g_ev) return;
+    long n = atomic_load(&g_nev);
+    if (n > g_evcap) n = g_evcap;
+    FILE *f = fopen(g_evpath, "wb");
+    if (!f) return;
+    fwrite(g_ev, sizeof(IoEv), (size_t)n, f);
+    fclose(f);
+}
